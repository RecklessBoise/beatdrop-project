# Copie ce fichier en .env.local (en local) et renseigne les mêmes variables
# dans Vercel > Project > Settings > Environment Variables.
# NE JAMAIS committer les vraies valeurs : le repo est public.

# --- Admin ---
# Mot de passe de ton espace admin
ADMIN_PASSWORD=change-moi
# Secret aléatoire (32+ caractères) pour signer la session. Ex : openssl rand -base64 48
SESSION_SECRET=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé "service_role" (secrète, côté serveur uniquement)
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 (R2 > Manage API tokens) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=beatdrop
